{
  "name": "harpoon-lagoon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@fontsource/fredoka": "5.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "three": "0.187.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "description": "A bright two-player co-op harpoon game for kids.",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.harpoonlagoon.game",
    "productName": "Harpoon Lagoon",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "HarpoonLagoon-${version}-portable.exe"
    }
  },
  "author": "omercanvural"
}
